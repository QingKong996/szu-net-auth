#!/bin/sh /etc/rc.common
# SZU dormitory campus-network authentication (single WAN account)
# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

# shellcheck source=/dev/null
[ -f /lib/functions.sh ] && . /lib/functions.sh

PROG=/etc/szu-netauth/auth.sh
STATE_DIR=/var/run/szu-netauth

start_service() {
	if [ ! -x "$PROG" ]; then
		logger -t szu-netauth "错误：$PROG 不存在或不可执行，服务未启动"
		return 1
	fi

	mkdir -p "$STATE_DIR"
	procd_open_instance
	procd_set_param command "$PROG" --daemon
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# 配置变化时唤醒常驻循环，让它在 5 秒内重新读取 UCI；不重启进程，
# 因而不会打断正在进行的一次登录请求。
reload_service() {
	mkdir -p "$STATE_DIR"
	touch "$STATE_DIR/wake"
	logger -t szu-netauth "配置已变更，正在重新读取"
}

service_triggers() {
	config_load szu-netauth
	config_get wan_iface global wan_interface wan
	case "$wan_iface" in
		''|*[!A-Za-z0-9_]*) wan_iface=wan ;;
	esac

	procd_add_reload_trigger "szu-netauth"
	# WAN 登录、重连、DHCP 续租等事件会立即唤醒认证循环。
	procd_add_interface_trigger "interface.*" "$wan_iface" /etc/init.d/szu-netauth reload
}
