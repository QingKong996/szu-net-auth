# =============================================================================
#  深圳大学宿舍区校园网自动认证
#  ⚠ 本文件含有明文校园网卡号和密码，权限必须保持 0600。
#     不要提交真实凭据，不要随备份外传。
#
#  修改后在 LuCI 点「保存并应用」，或执行：
#      uci commit szu-netauth
#      /etc/init.d/szu-netauth reload
# =============================================================================

config szu-netauth 'global'
	# 自动认证总开关。服务运行时，设为 0 会停止发起登录，但状态页仍可查看。
	option enabled '1'

	# 单个校园网账号。该账号只用于路由器 WAN，LAN 设备共享这一条已认证连接。
	option cardid ''
	option password ''

	# OpenWrt 逻辑网络接口名称；AX3000T 的 WAN 防火墙区域通常使用 wan。
	option wan_interface 'wan'

	# 正常在线时的复检间隔（秒）。
	option net_check '300'

	# 检测到离线后的重试间隔与单轮上限。
	option retry_interval '60'
	option retry_max '5'

	# 两次登录提交之间的绝对最小间隔（秒），用于避免触发门户限流。
	option login_min_interval '30'

	# 运行日志默认只写 logd 内存缓冲区；设为 1 才写入 flash。
	option persist_log '0'
