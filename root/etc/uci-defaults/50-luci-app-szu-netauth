#!/bin/sh
# 安装后 / 首次开机的一次性初始化。

[ -n "${IPKG_INSTROOT}" ] && exit 0

# 旧的多账号版本升级到单账号版本时，只迁移文件中的第一个完整可用账号。
# 新版本不再读取或轮换其他账号。全局旧字段只有在卡号和密码都非空时才算
# 可用，避免一个残缺字段导致下面误删本来能用的账号。
_global_id=$(uci -q get szu-netauth.global.cardid)
_global_pw=$(uci -q get szu-netauth.global.password)
if [ -z "$_global_id" ] || [ -z "$_global_pw" ]; then
	for _section in $(uci -q show szu-netauth 2>/dev/null \
		| sed -n 's/^szu-netauth\.\([^.=]*\)=account$/\1/p'); do
		_migrate_id=$(uci -q get "szu-netauth.$_section.cardid")
		_migrate_pw=$(uci -q get "szu-netauth.$_section.password")
		if [ -z "$_migrate_id" ] || [ -z "$_migrate_pw" ]; then
			continue
		fi
		uci -q set szu-netauth.global.cardid="$_migrate_id"
		uci -q set szu-netauth.global.password="$_migrate_pw"
		break
	done
fi

# 删除旧版本的 account 段，防止未显示的旧凭据继续留在配置文件中。
for _section in $(uci -q show szu-netauth 2>/dev/null \
	| sed -n 's/^szu-netauth\.\([^.=]*\)=account$/\1/p'); do
	uci -q delete "szu-netauth.$_section"
done

# UCI 脚本没有设置文件权限的 API，这里在迁移完成后收紧到 root-only。
uci -q commit szu-netauth
chmod 600 /etc/config/szu-netauth 2>/dev/null

mkdir -p /var/run/szu-netauth
rm -f /tmp/luci-indexcache* 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null
/etc/init.d/rpcd reload 2>/dev/null

if [ -x /etc/init.d/szu-netauth ]; then
	/etc/init.d/szu-netauth enable 2>/dev/null
	/etc/init.d/szu-netauth restart 2>/dev/null
fi

exit 0
